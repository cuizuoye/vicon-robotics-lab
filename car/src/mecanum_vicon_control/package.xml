<?xml version="1.0"?>
<package format="3">
  <name>mecanum_vicon_control</name>
  <version>0.1.0</version>
  <description>ROS 2 software-in-the-loop and Vicon pose control for a mecanum car.</description>
  <maintainer email="czy@example.com">czy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mecanum_description</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
