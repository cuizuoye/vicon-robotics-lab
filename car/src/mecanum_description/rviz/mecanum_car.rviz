Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot Model1
        - /Actual Path1
        - /Target Path1
        - /Planned Trajectory1
      Splitter Ratio: 0.55
    Tree Height: 720
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.25
      Plane Cell Count: 40
      Color: 130; 130; 135
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Name: Robot Model
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Marker Scale: 0.20
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Goal Pose
      Topic:
        Value: /car/goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 60; 60
      Shaft Length: 0.18
      Shaft Radius: 0.015
      Head Length: 0.06
      Head Radius: 0.03
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Goal Marker
      Marker Topic:
        Value: /car/goal_marker
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Actual Path
      Topic:
        Value: /car/path_actual
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 40; 230; 80
      Line Style: Lines
      Line Width: 0.015
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Target Path
      Topic:
        Value: /car/path_target
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 40; 130; 255
      Line Style: Lines
      Line Width: 0.015
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Planned Trajectory
      Topic:
        Value: /car/trajectory_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 210; 90; 255
      Line Style: Lines
      Line Width: 0.025
      Buffer Length: 1
  Global Options:
    Background Color: 35; 35; 38
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 120
      Target Frame: base_link
  Value: true
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
  Views:
    collapsed: false
