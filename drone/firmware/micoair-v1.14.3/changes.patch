+void
+Mavlink::handleMavlinkShellOutput()
+{
+	mavlink_serial_control_t msg{};
+	{
+		// 指针检查和使用必须同锁；不能在锁外先检查已被接收线程删除的对象。
+		const LockGuard lg{_mavlink_shell_mutex};
+
+		if (_mavlink_shell && _mavlink_shell->available() > 0
+		    && get_free_tx_buf() >= MAVLINK_MSG_ID_SERIAL_CONTROL_LEN + MAVLINK_NUM_NON_PAYLOAD_BYTES) {
+			msg.flags = SERIAL_CONTROL_FLAG_REPLY;
+			msg.device = SERIAL_CONTROL_DEV_SHELL;
+			msg.count = _mavlink_shell->read(msg.data, sizeof(msg.data));
+			msg.target_system = _mavlink_shell->targetSysid();
+			msg.target_component = _mavlink_shell->targetCompid();
+		}
+	}
+
+	// 串口发送可能等待缓冲区，不能在持有Shell生命周期锁时执行。
+	if (msg.count > 0) {
+		mavlink_msg_serial_control_send_struct(get_channel(), &msg);
+	}
+}
